# This file lists every environment variable read by the current application.
# The application loads the repository-root .env file at startup. Existing process
# environment values take precedence, so deployments can supply secrets externally.

# Allowed values: development, test, production. Default: development.
CHEIRON_ENV=development

# Allowed values: CRITICAL, ERROR, WARNING, INFO, DEBUG. Default: INFO.
CHEIRON_LOG_LEVEL=INFO

# Maximum ClinicalTrials.gov records one chart may retrieve. Range: 1-10000.
CHEIRON_RETRIEVAL_MAX_STUDIES=1000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Maximum simultaneous LLM query-planning calls in one API process. Range: 1-32.
CHEIRON_LLM_MAX_CONCURRENT_REQUESTS=4

# Maximum LLM query-planning calls per minute in one API process. Range: 1-600.
CHEIRON_LLM_MAX_REQUESTS_PER_MINUTE=60

LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
