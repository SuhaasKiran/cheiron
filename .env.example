# This file lists every environment variable read by the current application.
# The application reads environment variables; it does not load this file automatically.
# No API keys or provider credentials are required until those integrations are built.

# Allowed values: development, test, production. Default: development.
CHEIRON_ENV=development

# Allowed values: CRITICAL, ERROR, WARNING, INFO, DEBUG. Default: INFO.
CHEIRON_LOG_LEVEL=INFO
